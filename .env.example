# Dosthai AI provider — secrets stay server-side
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-luna
# Optional comma-separated allow-list. Leave empty to use Dosthai's current default catalog.
DOSTHAI_MODELS=gpt-5.6-luna,gpt-5.6-terra,gpt-5.6-sol

# Cloud persistence / accounts / files
DATABASE_URL=
AUTH_SECRET=
STORAGE_BUCKET=

# Knowledge / RAG
VECTOR_DATABASE_URL=

# Provider-neutral web research adapter
WEB_SEARCH_API_URL=
WEB_SEARCH_API_KEY=

# Multimodal capabilities
IMAGE_API_KEY=
SPEECH_API_KEY=

# Secure execution / model gateway
CODE_EXECUTION_ENABLED=false
AI_GATEWAY_API_KEY=

# Developer integrations
GITHUB_APP_ID=
GITHUB_TOKEN=
