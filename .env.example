# Dosthai AI provider — secrets stay server-side
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Set this to a real model ID supported by your configured provider.
OPENAI_MODEL=
# Optional comma-separated allow-list. If set, every ID must be supported by the provider.
DOSTHAI_MODELS=

# Cloud persistence / accounts / files
DATABASE_URL=
AUTH_SECRET=
STORAGE_BUCKET=

# Knowledge / RAG
VECTOR_DATABASE_URL=

# Provider-neutral web research adapter
WEB_SEARCH_API_URL=
WEB_SEARCH_API_KEY=

# Multimodal capabilities
IMAGE_API_KEY=
SPEECH_API_KEY=

# Secure execution / model gateway
CODE_EXECUTION_ENABLED=false
AI_GATEWAY_API_KEY=

# Developer integrations
GITHUB_APP_ID=
GITHUB_TOKEN=
