# Dosthai AI provider — secrets stay server-side
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-luna
# Optional comma-separated allow-list. Leave empty to use Dosthai's current default catalog.
DOSTHAI_MODELS=gpt-5.6-luna,gpt-5.6-terra,gpt-5.6-sol

# Advanced platform integrations (optional until implemented/configured)
DATABASE_URL=
AUTH_SECRET=
STORAGE_BUCKET=
VECTOR_DATABASE_URL=
WEB_SEARCH_API_KEY=
IMAGE_API_KEY=
SPEECH_API_KEY=
CODE_EXECUTION_ENABLED=false
AI_GATEWAY_API_KEY=
